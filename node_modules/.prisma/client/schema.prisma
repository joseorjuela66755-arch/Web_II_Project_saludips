// prisma/schema.prisma — Semana 6
// Traducción directa de docs/diagrama-clases.png.
// NOTA DE ADAPTACIÓN: el diagrama de clases real de SaludIPS NO tiene Sede, Servicio
// ni HistoriaClinica como entidades separadas: "Médico" es un Usuario con rol=MEDICO
// y especialidad; el historial clínico se consulta a partir de las Citas y Exámenes
// del paciente (caso de uso "Consultar historial clínico" en docs/casos-de-uso.png).
// Se modela tal como está en el diagrama para mantener trazabilidad con el Hito 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  MEDICO
  ADMINISTRATIVO
}

enum TipoCita {
  CONSULTA
  EXAMEN
}

enum EstadoCita {
  PROGRAMADA
  ATENDIDA
  CANCELADA
  NO_ASISTIO
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(120)
  email        String   @unique @db.VarChar(120)
  passwordHash String
  rol          Rol
  especialidad String?  @db.VarChar(80)
  creadoEn     DateTime @default(now())

  citasAtendidas Cita[] @relation("MedicoCitas")

  @@map("usuarios")
}

model Paciente {
  id              Int       @id @default(autoincrement())
  nombre          String    @db.VarChar(120)
  documento       String    @unique @db.VarChar(20)
  epsNombre       String?   @db.VarChar(80)
  fechaNacimiento DateTime?
  creadoEn        DateTime  @default(now())

  citas Cita[]

  @@map("pacientes")
}

model Cita {
  id        Int        @id @default(autoincrement())
  fecha     DateTime
  hora      String     @db.VarChar(5)
  tipo      TipoCita
  estado    EstadoCita @default(PROGRAMADA)
  prioridad Boolean    @default(false)
  creadoEn  DateTime   @default(now())

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  medicoId Int
  medico   Usuario @relation("MedicoCitas", fields: [medicoId], references: [id])

  examenes Examen[]
  factura  Factura?

  @@index([medicoId, fecha, hora])
  @@map("citas")
}

model Examen {
  id               Int      @id @default(autoincrement())
  tipoExamen       String   @db.VarChar(80)
  resultado        String
  recomendacionIA  String?
  fechaRealizacion DateTime @default(now())

  citaId Int
  cita   Cita @relation(fields: [citaId], references: [id])

  @@map("examenes")
}

model Factura {
  id           Int           @id @default(autoincrement())
  numero       String        @unique @db.VarChar(30)
  monto        Int
  estado       EstadoFactura @default(PENDIENTE)
  pdfUrl       String?
  fechaEmision DateTime      @default(now())

  citaId Int  @unique
  cita   Cita @relation(fields: [citaId], references: [id])

  @@map("facturas")
}
