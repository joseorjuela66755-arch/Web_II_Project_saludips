<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SaludIPS" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Proceso de atencion medica - SaludIPS" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Admin" name="Personal Administrativo">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recibir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Agendar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema">
        <bpmn:flowNodeRef>Task_Recordatorio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Asistio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarcarNoAsistio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Prioridad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reasignar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reasignado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Liberar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Liberado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarInicio</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Medico" name="Medico">
        <bpmn:flowNodeRef>Task_Historial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Atender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarResultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Diagnostico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsultarIA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmarDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CerrarCita</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Facturacion" name="Facturacion">
        <bpmn:flowNodeRef>Task_GenerarFactura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviarFactura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Final</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Recibir" name="Recibir solicitud de cita">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Verificar" name="Verificar disponibilidad">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Agendar" name="Agendar cita">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Recordatorio" name="Enviar recordatorio de cita">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Asistio" name="El paciente asistio?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Si</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_MarcarNoAsistio" name="Marcar cita como NO_ASISTIO">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Prioridad" name="Hay cita prioritaria en espera?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_PrioSi</bpmn:outgoing>
      <bpmn:outgoing>Flow_PrioNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Reasignar" name="Reasignar turno a paciente prioritario">
      <bpmn:incoming>Flow_PrioSi</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Notificar" name="Notificar nueva hora">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Reasignado" name="Fin">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_Liberar" name="Liberar espacio en agenda">
      <bpmn:incoming>Flow_PrioNo</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Liberado" name="Fin">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_RegistrarInicio" name="Registrar inicio de atencion">
      <bpmn:incoming>Flow_Si</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Historial" name="Consultar historial clinico">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Atender" name="Atender consulta / examen">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RegistrarResultado" name="Registrar resultado">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Diagnostico" name="Requiere apoyo diagnostico?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_DiagSi</bpmn:outgoing>
      <bpmn:outgoing>Flow_DiagNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ConsultarIA" name="Consultar recomendacion de IA">
      <bpmn:incoming>Flow_DiagSi</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ConfirmarDecision" name="Confirmar decision medica">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_DiagNo</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CerrarCita" name="Cerrar cita como ATENDIDA">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GenerarFactura" name="Generar factura PDF">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnviarFactura" name="Enviar factura a la EPS">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Final" name="Fin">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Recibir" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Recibir" targetRef="Task_Verificar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Verificar" targetRef="Task_Agendar" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Agendar" targetRef="Task_Recordatorio" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Recordatorio" targetRef="Gateway_Asistio" />
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_Asistio" targetRef="Task_MarcarNoAsistio" />
    <bpmn:sequenceFlow id="Flow_Si" name="Si" sourceRef="Gateway_Asistio" targetRef="Task_RegistrarInicio" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_MarcarNoAsistio" targetRef="Gateway_Prioridad" />
    <bpmn:sequenceFlow id="Flow_PrioSi" name="Si" sourceRef="Gateway_Prioridad" targetRef="Task_Reasignar" />
    <bpmn:sequenceFlow id="Flow_PrioNo" name="No" sourceRef="Gateway_Prioridad" targetRef="Task_Liberar" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Reasignar" targetRef="Task_Notificar" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Notificar" targetRef="EndEvent_Reasignado" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Liberar" targetRef="EndEvent_Liberado" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RegistrarInicio" targetRef="Task_Historial" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Historial" targetRef="Task_Atender" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Atender" targetRef="Task_RegistrarResultado" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RegistrarResultado" targetRef="Gateway_Diagnostico" />
    <bpmn:sequenceFlow id="Flow_DiagSi" name="Si" sourceRef="Gateway_Diagnostico" targetRef="Task_ConsultarIA" />
    <bpmn:sequenceFlow id="Flow_DiagNo" name="No" sourceRef="Gateway_Diagnostico" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ConsultarIA" targetRef="Task_ConfirmarDecision" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ConfirmarDecision" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_Merge" targetRef="Task_CerrarCita" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_CerrarCita" targetRef="Task_GenerarFactura" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_GenerarFactura" targetRef="Task_EnviarFactura" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_EnviarFactura" targetRef="EndEvent_Final" />
  </bpmn:process>

